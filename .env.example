# =============================================================================
# HFT IMBALANCE BOT v2.0 - PROFESSIONAL CONFIGURATION
# =============================================================================
# Deploy to VPS: Copy this file to .env and adjust API credentials
# Strategy: Long-only regime-aware trading with pro filters
# =============================================================================

# MODE
DRY_RUN=true

# API CREDENTIALS (Replace with your MEXC keys)
MEXC_API_KEY=your_api_key_here
MEXC_API_SECRET=your_api_secret_here

# TRADING PAIRS
SYMBOLS=BTC/USDT,ETH/USDT

# =============================================================================
# SIGNAL THRESHOLDS - MEXC 2025 Pro Config
# =============================================================================
# Imbalance range 0.70-1.35 was the ONLY profitable zone in backtesting
IMBALANCE_BUY_THRESHOLD=0.80
IMBALANCE_BUY_MAX=1.40
IMBALANCE_SELL_THRESHOLD=0.0
DISABLE_SELL=true

# Secondary signals
DELTA_SIGMA_THRESHOLD=2.5
SPEED_MULTIPLIER=3.0
VOLUME_SPIKE_RATIO=2.0
MICROPRICE_BUY_PCT=0.0004
MICROPRICE_SELL_PCT=-0.0004

# =============================================================================
# PRO FILTERS - New in v2.0 (Reduces trades from 9000/day to ~50/day)
# =============================================================================
# Rate Limiting: Minimum seconds between trades per symbol
RATE_LIMIT_SECONDS=60

# Loss Cooldown: Pause trading after consecutive losses
COOLDOWN_LOSSES=3
COOLDOWN_MINUTES=10

# Volatility Filter: Skip when spread is too wide
MAX_SPREAD_PCT=0.05

# Time Filter: Only trade during high liquidity hours (UTC)
TRADING_HOURS_START=13
TRADING_HOURS_END=20
ENABLE_TIME_FILTER=true

# Confidence Scoring: Minimum score (0-100) for entry
MIN_CONFIDENCE_SCORE=60

# =============================================================================
# SPOOFING DETECTION - Raised thresholds for quality signals
# =============================================================================
# Higher thresholds = fewer but higher-quality spoof detections
SPOOF_BTC_SIZE=200
SPOOF_ETH_SIZE=4000
SPOOF_WINDOW_MS=800
SPOOF_BLOCK_SECONDS=15

# =============================================================================
# EXECUTION PARAMETERS
# =============================================================================
# Take Profit targets
TP_BTC_PCT=0.04
TP_ETH_PCT=0.06

# Stop Loss
SL_PCT=0.03

# Trailing Stop (locks profits as price moves in your favor)
USE_TRAILING_STOP=true
TRAILING_STOP_PCT=0.02

# Position Management
MAX_POSITION_LIFETIME=12.0
RISK_PER_TRADE_PCT=0.3
MAX_POSITIONS_PER_PAIR=1

# =============================================================================
# TIMING WINDOWS
# =============================================================================
DELTA_WINDOW_MS=300
MICROPRICE_WINDOW_MS=2000
IMBALANCE_SPEED_WINDOW_SEC=5
SPEED_AVG_WINDOW_SEC=300

# =============================================================================
# NETWORK
# =============================================================================
WS_PING_INTERVAL=30
WS_RECONNECT_MAX_DELAY=60
REQUEST_TIMEOUT=10
MAX_RETRIES=3

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_ROTATION=100 MB
LOG_RETENTION=7 days
BOT_VERSION=2.0.0
